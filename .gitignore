# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Packaging & distribution
build/
dist/
*.egg-info/
.eggs/
*.egg

# Pytest, coverage & linters
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments & secrets
.venv/
venv/
ENV/
env/
.env
.env.*

# Large model binaries and Hugging Face caches
# Note: models/bge-small-zh-v1.5/{tokenizer.json,onnx/model.onnx} are intentionally tracked for offline CPU embedding & tests
models/*.gguf
models/*.bin
models/*.safetensors
models/.cache/
models/**/.cache/

# Local llama.cpp binaries and download archives
# Note: bin/LICENSE-LLVM-OpenMP is intentionally tracked
bin/*.exe
bin/*.dll
bin/*.so
bin/*.dylib
bin/*.zip
bin/*.zip.incomplete
bin/*.tar.gz

# Runtime data, SQLite databases, snapshots, logs, uploads, and exports
data/
/*.db
/*.db-wal
/*.db-shm

# IDE & OS generated files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
